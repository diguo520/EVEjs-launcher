{
  "name": "evejs-launcher-shell",
  "private": true,
  "version": "0.3.8",
  "description": "EvEJS 启动器 · Tauri 2 外壳（Rust） + legacy 渲染层（原样复用现役版 HTML/JS）",
  "scripts": {
    "contract": "node scripts/extract-contract.mjs && node scripts/gen-contract.mjs",
    "verify": "node scripts/verify-contract.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:sync": "node scripts/sync-version.mjs",
    "package": "pwsh -File scripts/package.ps1",
    "package:nsis": "pwsh -File scripts/package.ps1 -Nsis",
    "audit": "node scripts/audit-security.mjs",
    "dedup": "node scripts/audit-dedup.mjs",
    "parity": "node tests/parity/run.mjs",
    "parity:dump": "node tests/parity/driver-tauri.mjs",
    "parity:diff": "node tests/parity/diff.mjs",
    "parity:channels": "node tests/parity/driver-tauri.mjs && node tests/parity/diff.mjs",
    "parity:channels:update": "node tests/parity/driver-tauri.mjs && node tests/parity/diff.mjs --update",
    "parity:electron": "node tests/parity/driver-electron.mjs",
    "parity:electron:update": "node tests/parity/driver-electron.mjs && node tests/parity/diff.mjs --current .parity-out/electron.json --baseline tests/parity/fixtures/channels/electron-baseline.json --update",
    "parity:cross": "node tests/parity/driver-tauri.mjs && node tests/parity/diff.mjs && node tests/parity/driver-electron.mjs && node tests/parity/diff.mjs --current .parity-out/electron.json --baseline tests/parity/fixtures/channels/electron-baseline.json && node tests/parity/diff-cross.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:update": "node tests/e2e/run.mjs --repeats 1 --keep",
    "reach": "node scripts/audit-legacy-reachability.mjs --src \"E:/Games/EveJS-v0.12.8/launcher/launcher\"",
    "dup": "npx --yes jscpd@4 --min-lines 10 --min-tokens 70 --threshold 1 --reporters console --ignore \"**/ui/web/**,**/ui/dist/**,**/vendor/**,**/src-tauri/gen/**,**/src-tauri/target/**,**/node_modules/**,**/docs/**,**/.audit/**\" --format \"javascript,typescript,rust\" .",
    "check:renderer": "node scripts/check-renderer.mjs",
    "ui:build": "node ui/scripts/build-ui.mjs",
    "keys:update": "node scripts/gen-update-key.mjs",
    "size": "node scripts/size-gate.mjs",
    "size:zip": "node scripts/size-gate.mjs --require-zip",
    "smoke:ipc": "pwsh -File scripts/smoke-ipc.ps1",
    "smoke:webview2": "pwsh -File scripts/smoke-webview2-missing.ps1",
    "ui:app:install": "npm --prefix ui install --no-audit --no-fund",
    "ui:app:typecheck": "npm --prefix ui run typecheck",
    "ui:app:dev": "npm --prefix ui run dev",
    "ui:app:build": "node scripts/check-app.mjs --build-only",
    "check:app": "node scripts/check-app.mjs",
    "check": "node scripts/verify-contract.mjs && node scripts/sync-version.mjs --check && node scripts/audit-security.mjs && node scripts/audit-dedup.mjs && node tests/parity/run.mjs && node scripts/check-renderer.mjs && node scripts/check-bridge-calls.mjs && node ui/scripts/build-ui.mjs --check"
  },
  "engines": {
    "node": ">=20"
  }
}
